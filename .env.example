bash
# ============================================================
# VidaCruz Triage — Variables de entorno
# Copiar a .env y rellenar valores reales. NUNCA commitear .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=vidacruz
POSTGRES_USER=vidacruz
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM Provider (OpenAI / Azure OpenAI / Gemini / etc.) ---
LLM_API_KEY=sk-reemplazar
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com

# --- Seguridad API ---
# Header X-API-Key que deben enviar los clientes en cada request
API_KEY_HEADER=vidacruz-dev-api-key-cambiar

# --- RF-06: Webhook de alertas de escalamiento ---
SLACK_WEBHOOK_URL=
# Alternativa Teams:
# TEAMS_WEBHOOK_URL=

# --- Escalamiento SLA (segundos; en dev bajar para probar rápido) ---
TRIAGE_SLA_CHECK_INTERVAL_SECONDS=30
TRIAGE_SLA_OVERRIDE_SECONDS=